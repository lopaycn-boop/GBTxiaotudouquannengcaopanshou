{
  "name": "potato-ai-trader",
  "version": "1.21.0",
  "description": "🌱 GBTxiaotudou AI操盘 — 自动交易+全电脑操控+AI助手",
  "author": "自由的风",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.openclaw.potato-pet",
    "productName": "GBTxiaotudou AI操盘",
    "npmRebuild": true,
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "!../**/__pycache__/**",
      "!../../**/__pycache__/**",
      "!../**/node_modules/**",
      "!../../**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "frontend/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../../dist/potato-backend",
        "to": "potato-backend",
        "filter": ["**/*"]
      },
      {
        "from": "../../data",
        "to": "data",
        "filter": [
          "**/*",
          "!*.db",
          "!*.sqlite",
          "!*.sqlite3",
          "!*.vault_salt",
          "!user_prefs.json"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": ["zh-CN"],
      "language": 2052,
      "installerIcon": "assets/icon.ico",
      "unicode": true
    },
    "portable": {
      "artifactName": "GBTxiaotudouAI操盘-${version}-Portable.exe"
    },
    "mac": {
      "target": [
        {
          "target": "zip",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": [
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Office",
      "maintainer": "自由的风"
    },
    "publish": {
      "provider": "github",
      "owner": "lopaycn-boop",
      "repo": "GBTxiaotudouAI操盘"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "app-builder-bin": "^4.2.0",
    "electron-updater": "^6.8.3",
    "robotjs": "^0.7.1",
    "screenshot-desktop": "^1.15.4"
  }
}
