{
  "name": "gbtxiaotudou-quannengcaopanshou",
  "version": 2,
  "buildCommand": "cd desktop_pet/frontend && npm install && npm run build",
  "outputDirectory": "desktop_pet/frontend/dist",
  "installCommand": "cd desktop_pet/frontend && npm install",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}